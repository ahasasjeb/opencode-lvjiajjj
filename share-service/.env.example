# Pooled Neon connection string. Never commit the real credential.
DATABASE_URL=postgresql://user:password@host/database?sslmode=require

# Public origin used in URLs returned to opencode clients.
PUBLIC_BASE_URL=http://localhost:3000

# Optional. When set, /api/shares requires this exact Bearer token.
# When omitted, org routes accept any non-empty Bearer token for local development.
ORG_BEARER_TOKEN=
